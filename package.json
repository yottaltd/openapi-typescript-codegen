{
  "name": "@yottaltd/openapi-typescript-codegen",
  "version": "1.2.2",
  "description": "Library that generates Typescript clients based on the OpenAPI specification.",
  "author": "Ferdi Koomen",
  "homepage": "https://github.com/yottaltd/openapi-typescript-codegen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yottaltd/openapi-typescript-codegen.git"
  },
  "bugs": {
    "url": "https://github.com/yottaltd/openapi-typescript-codegen/issues"
  },
  "license": "MIT",
  "keywords": [
    "openapi",
    "swagger",
    "codegen",
    "generator",
    "client",
    "typescript",
    "yaml",
    "json",
    "fetch",
    "xhr",
    "node"
  ],
  "maintainers": [
    {
      "name": "Craig McNicholas",
      "email": "craig.mcnicholas@weareyotta.com"
    }
  ],
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "bin": {
    "openapi": "bin/index.js"
  },
  "files": [
    "bin/index.js",
    "dist/index.js",
    "types/index.d.ts"
  ],
  "scripts": {
    "clean": "rimraf ./dist ./test/generated ./test/e2e/generated ./samples/generated ./coverage ./node_modules/.cache",
    "build": "rollup --config --environment NODE_ENV:development",
    "build:watch": "rollup --config --environment NODE_ENV:development --watch",
    "release": "rollup --config --environment NODE_ENV:production",
    "run": "node ./test/index.js",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 --no-fix",
    "lint:fix": "eslint --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "codecov": "codecov --token=66c30c23-8954-4892-bef9-fbaed0a2e42b"
  },
  "dependencies": {
    "camelcase": "^6.3.0",
    "commander": "^10.0.0",
    "handlebars": "^4.7.9",
    "js-yaml": "^4.1.0",
    "json-schema-ref-parser": "^9.0.9",
    "mkdirp": "^2.1.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.21.0",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/express": "^4.17.17",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.2",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "codecov": "^3.8.3",
    "eslint": "^9.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "glob": "^8.1.0",
    "node-fetch": "^3.3.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "puppeteer": "^19.7.2",
    "qs": "^6.11.0",
    "rimraf": "^5.0.0",
    "rollup": "^3.17.2",
    "tslib": "^2.5.0",
    "typescript": "^4.9.5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "minimist": "1.2.8"
  }
}
